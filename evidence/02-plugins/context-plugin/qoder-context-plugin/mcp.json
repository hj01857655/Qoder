{
  "mcpServers": {
    "qoder-context": {
      "command": "${QODER_NODE_RUNTIME}",
      "args": [
        "${QODER_PLUGIN_ROOT}/runtime/qoder-search.bundle.mjs",
        "mcp-bridge"
      ],
      "env_vars": [
        "QODER_HOME",
        "QODER_ENV",
        "QODER_BIG_MODEL_ENDPOINT",
        "QODER_OPENAPI_ENDPOINT",
        "QODERCN_VPC_ENDPOINT",
        "QODERCN_VPC_OPENAPI_ENDPOINT"
      ],
      "env": {
        "QODER_PRODUCT_ID": "qoder-cn",
        "QODER_SEARCH_PRODUCT_FORM": "qoder",
        "QODER_MTREE_NATIVE": "${QODER_PLUGIN_ROOT}/runtime/native/mtree/index.cjs",
        "QODER_SEARCH_RIPGREP_PATH": "${QODER_PLUGIN_ROOT}/bin/rg.exe",
        "QODER_SEARCH_BUILD_ID": "1.0.72.34cf9e2f-win32-x64"
      },
      "qoderAuthState": true,
      "startup": "application",
      "timeout": 600000,
      "alwaysAllow": [
        "SearchKnowledge"
      ],
      "toolOverrides": {
        "SearchKnowledge": {
          "exposedName": "SearchKnowledge",
          "alwaysLoad": true
        }
      }
    }
  }
}
