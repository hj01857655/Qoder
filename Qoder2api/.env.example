# Qoder2api 配置（env 只存配置；凭证一律走 credentials.json，不放 env）
# 端口
PORT=8388

# API Key 鉴权 (留空则不鉴权)
API_KEY=

# 请求超时 (秒)
QODER_TIMEOUT=120

# 凭证：唯一凭证文件是项目根的 credentials.json（dt- 访问令牌 + drt- 刷新令牌）。
# 由 device flow 登录生成（首次启动无凭证时会打印授权 URL 并阻塞等待，或 POST /login 非阻塞登录），
# 续期轮换后自动覆盖写；删除该文件即重新登录。QODER_PERSIST=0 关闭落盘（仅内存）。
# QODER_PERSIST=1
